# Do not put real secrets into GitHub, GitHub Pages or browser JavaScript.
PORT=8080
BRIDGE_SHARED_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Use the base URL supplied by Libya Cards' own private API documentation.
LIBYACARD_API_BASE_URL=
LIBYACARD_API_TOKEN=
# Allowed: Authorization or X-API-Key; follow Libya Cards' actual API docs.
LIBYACARD_AUTH_HEADER=Authorization
LIBYACARD_AUTH_PREFIX=Bearer
# Supplier-specific paths; fill these in ONLY after checking their documentation.
LIBYACARD_PRODUCTS_PATH=
LIBYACARD_CREATE_ORDER_PATH=
LIBYACARD_ORDER_STATUS_PATH_TEMPLATE=
# Dangerous operations disabled by default. Enable only after secure payment validation.
LIBYACARD_ENABLE_ORDERS=false
